{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "600px",
      "wideSize": "1380px"
    },
    "color": {
      "palette": [
        {
          "slug": "accent",
          "color": "#3b8dbd",
          "name": "Accent"
        },
        {
          "slug": "topbar",
          "color": "#26272b",
          "name": "Topbar"
        },
        {
          "slug": "header",
          "color": "#3b8dbd",
          "name": "Header"
        },
        {
          "slug": "footer",
          "color": "#33363b",
          "name": "Footer"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "White"
        },
        {
          "slug": "black",
          "color": "#000000",
          "name": "Black"
        }
      ],
      "custom": true,
      "customDuotone": true,
      "customGradient": true,
      "defaultPalette": false,
      "link": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true,
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "typography": {
      "customFontSize": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true,
      "dropCap": false,
      "fontFamilies": [
        {
          "fontFamily": "'Titillium Web', sans-serif",
          "name": "Titillium Web",
          "slug": "titillium-web"
        },
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
          "name": "System Font",
          "slug": "system-font"
        }
      ]
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": true
        }
      },
      "core/pullquote": {
        "border": {
          "color": true,
          "radius": true,
          "style": true,
          "width": true
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "#fff",
      "text": "#2d2d2d"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--titillium-web)",
      "fontSize": "15px",
      "lineHeight": "1.7"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--accent)"
        },
        ":hover": {
          "color": {
            "text": "#2d2d2d"
          }
        }
      },
      "h1": {
        "typography": {
          "fontSize": "36px",
          "lineHeight": "1.2",
          "fontWeight": "700"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "30px",
          "lineHeight": "1.2",
          "fontWeight": "700"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "24px",
          "lineHeight": "1.2",
          "fontWeight": "700"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "18px",
          "lineHeight": "1.3",
          "fontWeight": "700"
        }
      }
    },
    "blocks": {
      "core/button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "#fff"
        },
        "typography": {
          "fontSize": "14px",
          "fontWeight": "600"
        },
        "border": {
          "radius": "3px"
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "child-menu",
      "title": "Child Menu",
      "postTypes": ["page"]
    }
  ]
}
